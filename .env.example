# ==============================================================================
# BizPulse Development Environment Template
# Copy this file to .env for local development
# ==============================================================================

# Application Environment (development | production)
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (comma-separated list of browser frontend origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication & Security
JWT_SECRET_KEY=bizpulse_dev_jwt_secret_key_change_in_production_2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
AUTH_PROVISIONING_KEY=bizpulse_demo_provisioning_key_2026

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Observability & Logging
LOG_LEVEL=INFO

# Storage Paths (Optional: defaults to backend/data)
# DATA_DIR=
# DATABASE_PATH=
# BACKUP_DIR=
