# ==============================================================================
# BizPulse Production Environment Configuration Reference
# ==============================================================================
# IMPORTANT:
# 1. Never commit this file with production values to source control.
# 2. Generate cryptographically strong secrets before running in production.
# 3. Supply these variables via your cloud deployment environment, Kubernetes
#    secrets, or a secured .env file with permissions 0600.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application Settings
# ------------------------------------------------------------------------------
# MUST be set to 'production' to enforce strict security validations.
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# CORS & Network Boundaries
# ------------------------------------------------------------------------------
# Comma-separated list of exact allowed browser origins.
# - MUST NOT contain wildcards ('*')
# - In production, replace with your exact domain(s)
ALLOWED_ORIGINS=https://bizpulse.example.com,https://app.bizpulse.example.com

# Reverse Proxy Trust Configuration
# Set to 'true' when operating behind Nginx, Traefik, ALB, or Cloudflare
TRUST_PROXY_HEADERS=true
TRUSTED_PROXIES=frontend,127.0.0.1,10.0.0.0/8

# ------------------------------------------------------------------------------
# Authentication & JWT Security
# ------------------------------------------------------------------------------
# High-entropy signing secret (minimum 32 characters, recommended 64+ hex characters).
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_cryptographically_secure_random_key_min_32_characters

# JWT signing algorithm (HS256, HS384, HS512, RS256)
JWT_ALGORITHM=HS256

# Session expiration window in minutes (default 60 minutes = 1 hour)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Secure Cookie Flag: MUST be 'true' in production (requires HTTPS)
COOKIE_SECURE=true

# Open Registration: MUST be 'false' in production.
# New user onboarding must use the AUTH_PROVISIONING_KEY.
ALLOW_REGISTRATION=false

# Dedicated administrative secret for controlled user provisioning.
# Generate with: openssl rand -hex 24
AUTH_PROVISIONING_KEY=replace_with_a_secure_provisioning_key_min_24_characters

# ------------------------------------------------------------------------------
# Google Gemini AI Integration
# ------------------------------------------------------------------------------
# API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_production_google_gemini_api_key

# Model name for multi-agent reasoning and investigations
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# Observability & Logging
# ------------------------------------------------------------------------------
# Log level: INFO, WARNING, or ERROR for production (DEBUG is too verbose)
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Storage & Persistence Paths
# ------------------------------------------------------------------------------
# Configured automatically inside the container volume mount:
DATABASE_PATH=/app/data/bizpulse.db
BACKUP_DIR=/app/data/backups
DATA_DIR=/app/data

# ------------------------------------------------------------------------------
# Frontend Exposure
# ------------------------------------------------------------------------------
# Host port mapping for Nginx frontend web server
FRONTEND_PORT=80
